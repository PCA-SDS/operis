{
  "mcpServers": {
    "open-mercato": {
      "type": "http",
      "url": "http://localhost:3001/mcp",
      "headers": {
        "x-api-key": "omk_..."
      }
    },
    "graft": {
      "command": "graft",
      "args": ["mcp"]
    },
    "graphify": {
      "command": "REPLACE_WITH__cat_graphify-out_dot_graphify_python",
      "args": ["-m", "graphify.serve", "graphify-out/graph.json"]
    }
  }
}
