{
  "name": "@open-mercato/channel-apns",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./modules/channel_apns": {
      "types": "./src/modules/channel_apns/index.ts",
      "default": "./dist/modules/channel_apns/index.js"
    },
    "./modules/channel_apns/contract": {
      "types": "./src/modules/channel_apns/contract.ts",
      "default": "./dist/modules/channel_apns/contract.js"
    },
    "./modules/channel_apns/*": null,
    "./internal/*.json": "./src/*.json",
    "./internal/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": [
        "./dist/*.js",
        "./dist/*/index.js"
      ]
    },
    ".": "./dist/index.js",
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*.json": "./src/*/*/*/*/*.json",
    "./*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*.ts",
        "./src/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@open-mercato/core": "workspace:*",
    "@open-mercato/ui": "workspace:*",
    "@parse/node-apn": "^6.0.1"
  },
  "peerDependencies": {
    "@mikro-orm/postgresql": "^7.0.14",
    "@open-mercato/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@open-mercato/shared": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "jest": "^30.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-jest": "^29.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PCA-SDS/operis",
    "directory": "packages/channel-apns"
  }
}
