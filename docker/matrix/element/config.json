{
  "_comment": [
    "Element Web is an ENGINEERING CONSOLE for local development only.",
    "It is AGPL-3.0 and is never shipped, never deployed, and never the Operis",
    "chat UI. It exists so a developer can look at what the appservice actually",
    "wrote into a room with a mature Matrix client, instead of inferring it from",
    "curl output. See ADR-0006.",
    "It starts only under the `matrix` compose profile."
  ],
  "default_server_config": {
    "m.homeserver": {
      "base_url": "http://localhost:8008",
      "server_name": "operis.local"
    }
  },
  "brand": "Operis Matrix Console",
  "disable_custom_urls": true,
  "disable_guests": true,
  "disable_3pid_login": true,
  "default_country_code": "SG",
  "show_labs_settings": true,
  "room_directory": {
    "servers": []
  },
  "setting_defaults": {
    "UIFeature.registration": false,
    "UIFeature.passwordReset": false,
    "UIFeature.deactivate": false,
    "UIFeature.identityServer": false,
    "UIFeature.thirdPartyId": false,
    "UIFeature.feedback": false,
    "UIFeature.shareSocial": false,
    "UIFeature.urlPreviews": false
  },
  "features": {},
  "enable_presence_by_hs_url": {
    "http://localhost:8008": false
  }
}
