# Synapse logging for local development.
#
# Structured-ish, stdout only, so `docker compose logs synapse` is the single
# place to look. No file handler: the container is cattle and its filesystem is
# a bind mount we do not want filling with rotated logs.

version: 1

formatters:
  precise:
    format: "%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s"

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
    stream: ext://sys.stdout

loggers:
  synapse.storage.SQL:
    # Every SQL statement Synapse runs. Useful exactly once, while debugging a
    # slow query; deafening otherwise.
    level: WARNING

  synapse.access.http.8008:
    # One line per client request. At INFO this is how you confirm the
    # appservice is actually reaching the homeserver.
    level: INFO

  synapse.appservice:
    # The transaction sender. DEBUG here is what tells you whether an event was
    # queued for the appservice and how the delivery went.
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
