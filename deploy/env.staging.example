# ==============================================================================
# Operis — STAGING environment  ->  /opt/operis-staging/.env   (chmod 600)
# ==============================================================================
# This is a DELTA, not a whole file.
#
#   1. Start from env.production.example — it is the complete, annotated list
#      and the only place each variable is explained.
#   2. Apply every override below.
#
# Deliberately not a 400-line fork. Two copies of that file drift, and the copy
# that drifts is staging — which then stops being a rehearsal of production and
# starts being a different system that happens to run the same image.
#
#   scp deploy/env.production.example operis@SERVER:/opt/operis-staging/.env
#   ssh operis@SERVER 'chmod 600 /opt/operis-staging/.env && nano /opt/operis-staging/.env'
#
# ------------------------------------------------------------------------------
# GENERATE STAGING ITS OWN SECRETS. DO NOT COPY PRODUCTION'S.
#
# Run the generator block at the top of env.production.example again, on this
# box, and paste fresh output. Staging is a lower-trust environment: more people
# touch it, it holds test data, and its logs get pasted into issues. A shared
# JWT_SECRET or AUTH_SECRET means a token minted on staging is valid against
# production.
#
# TENANT_DATA_ENCRYPTION_FALLBACK_KEY and LOOKUP_HASH_PEPPER get fresh values
# too. They are permanent per-stack, but staging's database is seeded from
# scratch, so there is no existing ciphertext for them to orphan — and sharing
# them is what would make a production backup readable here.
# ==============================================================================


# ==============================================================================
# 1. STACK IDENTITY — the override that matters most
# ==============================================================================
# docker-compose.yml derives the compose project, all five container names, the
# internal network and all five volume names from this. Omit it and everything
# renders as `operis`: this stack would adopt PRODUCTION's containers and
# volumes, and a deploy here would recreate the production app.
#
# deploy.sh asserts this against the EXPECTED_STACK that CI passes and refuses
# to start if they disagree, so a missing value fails loudly rather than
# silently. Do not rely on that guard as a substitute for setting it.
STACK_NAME=operis-staging

APP_DOMAIN=operis-staging.faheemkamel.com
APP_URL=https://operis-staging.faheemkamel.com

# Same gateway as production. Both stacks join it; nginx resolves each app
# container by its own name.
EDGE_NETWORK=pca-erp-network

# Same image, same registry — staging deploys the exact digest production will
# later run. CI passes --image explicitly, so this is only a manual-run fallback.
APP_IMAGE=ghcr.io/pca-sds/operis


# ==============================================================================
# 2. DATABASE — own credentials, own volume
# ==============================================================================
# The database name differs from production's on purpose. The volumes are
# already separated by STACK_NAME, so this is belt-and-braces: it makes a
# mis-pointed DATABASE_URL or a hand-run psql obvious rather than silently
# correct-looking.
POSTGRES_USER=operis
POSTGRES_PASSWORD=            # generate a NEW one — not production's
POSTGRES_DB=operis_staging


# ==============================================================================
# 3. RESOURCE CAPS — staging shares a host with five production stacks
# ==============================================================================
# The box has 8 vCPU and ~22 GB, NO SWAP, and already runs pca-erp,
# pca_accounting, pca-client-profile, prive-booking and Operis production. With
# no swap the kernel does not slow down when memory runs out, it kills
# something — and it does not necessarily kill staging.
#
# Measured on the box 2026-09-18: all 28 containers together use ~4.0 GiB, and
# `free -h` reports 17 GiB available. Production Operis is 1.9 GiB of that
# (app 1.0G, translation 610M, postgres 276M, meilisearch 36M, redis 22M).
# Staging is the same shape, so budget ~2 GiB for it and expect ~15 GiB still
# free. There is real headroom here; these caps are about bounding a QA
# environment's blast radius, not about scraping by.
#
# Postgres is roughly half production's settings rather than a quarter: it is
# affordable at this headroom, and shared_buffers that is too small makes the
# planner behave differently from production, which is the opposite of what a
# rehearsal environment is for.
#
# >>> RE-CHECK IF THE HOST GAINS ANOTHER STACK <<<
#   free -h; docker stats --no-stream --format "table {{.Name}}\t{{.MemUsage}}"
# If available memory ever drops below ~6 GB, drop the translation engine first
# (section 4) — it is the single largest line item in this stack.
PG_MAX_CONNECTIONS=60
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
# Louder than production's 2000ms: on staging a slow query is something to find,
# not something to ride out.
PG_LOG_MIN_DURATION_MS=1000

REDIS_MAXMEMORY=384mb


# ==============================================================================
# 4. TRANSLATION ENGINE — the one to cut first
# ==============================================================================
# Production's limit is 3g; measured actual usage there is 610 MiB, so 2560m is
# a ceiling with room, not a squeeze. Do not go far below it: the weights are
# ~2 GB once loaded and a limit under that OOMs during startup rather than
# failing cleanly.
#
# Keep it enabled. At 17 GiB available the memory is affordable, and a staging
# environment missing a service production has is a staging environment that
# cannot rehearse it.
#
# To run staging WITHOUT it — the right call if this host gets tighter — stop
# the service after the first deploy and leave it stopped:
#
#   cd /opt/operis-staging && ./dc stop translation && ./dc rm -f translation
#
# The app degrades to untranslated content; nothing else breaks. Note the next
# deploy starts it again (compose has no profile for it), so if you want it gone
# permanently, say so and it becomes a compose profile rather than a manual step.
TRANSLATION_MEM_LIMIT=2560m
TRANSLATION_CPUS=1
TRANSLATION_INTER_THREADS=1
TRANSLATION_INTRA_THREADS=2


# ==============================================================================
# 5. FIRST-BOOT SUPERADMIN
# ==============================================================================
# `mercato init` runs once on first boot and creates this account. A DIFFERENT
# password from production, generated fresh. Change it after first sign-in
# exactly as you would in production — this host is on the public internet.
OM_INIT_SUPERADMIN_EMAIL=
OM_INIT_SUPERADMIN_PASSWORD=  # openssl rand -base64 18
ADMIN_EMAIL=


# ==============================================================================
# 6. STILL DO NOT SET THESE — section J applies here too
# ==============================================================================
# operis-staging.faheemkamel.com is publicly reachable, behind the same gateway,
# with a real certificate. It is not a private environment; it is production's
# twin with test data in it. Everything section J of env.production.example
# forbids is forbidden here for the same reason:
#
#   DEMO_MODE=true                  OM_AUTOLOGIN_EMAIL / OM_AUTOLOGIN_PASSWORD
#   FORCE_HOST_SECRET               OM_DEV_SEED_PASSWORD
#   NEXT_PUBLIC_UMES_DEVTOOLS=true
#
# OM_AUTOLOGIN_* is the tempting one — "it's only staging, save QA a login" —
# and it signs in every visitor who finds the hostname, including a crawler.
# The vhost sends X-Robots-Tag: noindex, which discourages indexing and
# prevents nothing.
#
# As in production, NEXT_PUBLIC_* cannot be set here at all: Next.js inlines
# those at BUILD time, and staging deliberately runs the same image as
# production, built with no .env.


# ==============================================================================
# 7. EMAIL — the override that is cheapest to forget and dearest to get wrong
# ==============================================================================
# Staging exercises the same notification paths as production: invitations,
# password resets, notification digests. Give it production's Resend key and it
# will send real mail, from your verified production domain, to whatever
# addresses are sitting in the staging database.
#
# Two defensible choices:
#
#   a) Leave RESEND_API_KEY empty. The app starts fine and silently mails
#      nobody. Safest, and it means QA cannot test any email-dependent flow —
#      including the account-recovery path you most want tested.
#
#   b) A SEPARATE Resend key on a SEPARATE sending domain or subdomain
#      (e.g. staging-mail.yourdomain.com). Email flows become testable and
#      nothing can be sent as production. This is the better option if QA needs
#      invitations or resets.
#
# What is NOT a choice: production's key. Recommended default is (a) until
# someone needs email on staging, then move to (b).
RESEND_API_KEY=
# Never a production sender, even while the key above is empty — an accidental
# key paste should not also be an accidental production `From:`.
EMAIL_FROM=no-reply@operis-staging.faheemkamel.com
NOTIFICATIONS_EMAIL_FROM=
# Portal links in outbound mail must point at STAGING. Pointed at production,
# a tester following a staging invitation lands on the real system.
PLATFORM_PORTAL_BASE_URL=https://operis-staging.faheemkamel.com
