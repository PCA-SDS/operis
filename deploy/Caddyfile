# ==============================================================================
# Operis — Caddy reverse proxy
# ==============================================================================
# Caddy obtains and renews Let's Encrypt certificates automatically. There is no
# certbot, no cron renewal, no nginx config to regenerate. Requirements:
#   * APP_DOMAIN resolves (A/AAAA record) to this server
#   * ports 80 and 443 reachable from the internet (ACME HTTP-01 challenge)
#
# Certificates persist on the caddy_data volume. Never delete that volume
# casually — Let's Encrypt rate-limits re-issuance to 5 duplicate certs/week.
# ==============================================================================
{
	email {$ACME_EMAIL}

	# Uncomment to iterate against the Let's Encrypt STAGING CA while testing DNS
	# and firewall. Staging certs are untrusted by browsers but effectively
	# unrate-limited — use it if you expect several failed attempts, then comment
	# it out and run `./dc restart caddy` for real certificates.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	servers {
		# Operis reads the client IP from X-Forwarded-For with
		# RATE_LIMIT_TRUST_PROXY_DEPTH=1. Caddy is the only hop, so it must
		# overwrite (not append to) any client-supplied header.
		trusted_proxies static private_ranges
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# 1 year HSTS. Only safe once HTTPS works — a wrong value here locks
		# browsers out of the domain for a year. Leave commented on day one,
		# enable after a successful HTTPS load.
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Attachment uploads. Keep at or above OM_ATTACHMENT_MAX_UPLOAD_MB plus
	# multipart overhead, otherwise large uploads fail at the edge with 413
	# before the application ever sees them.
	request_body {
		max_size 32MB
	}

	# Next.js streams responses (RSC payloads, the SSE event bridge). Caddy
	# detects text/event-stream and flushes those immediately — no buffering
	# config needed. X-Forwarded-{For,Proto,Host} are set by default.
	reverse_proxy {$APP_UPSTREAM} {
		header_up X-Real-IP {remote_host}

		# Give the app time to answer during a cold start rather than 502-ing.
		transport http {
			dial_timeout 10s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format json
		# Health probes every 15s would otherwise dominate the log volume.
		# (Container healthchecks hit the app directly and never reach Caddy;
		# this filters external uptime monitors.)
	}
}

# --- Optional: redirect the apex domain to www, or vice versa -----------------
# example.com {
# 	redir https://app.example.com{uri} permanent
# }
