# ==============================================================================
# Operis — production environment  ->  /opt/operis/.env   (chmod 600)
# ==============================================================================
# This file is the ONLY place production secrets live. It is created by hand on
# the server, never committed, never rsynced, never printed by CI. The deploy
# pipeline does not read it and cannot overwrite it.
#
#   scp deploy/env.production.example deploy@SERVER:/opt/operis/.env
#   ssh deploy@SERVER 'chmod 600 /opt/operis/.env && nano /opt/operis/.env'
#
# ------------------------------------------------------------------------------
# GENERATE EVERY SECRET AT ONCE — run this on the server and paste the output in:
#
#   for v in JWT_SECRET AUTH_SECRET NEXTAUTH_SECRET CONSENT_INTEGRITY_SECRET \
#            TENANT_DATA_ENCRYPTION_FALLBACK_KEY LOOKUP_HASH_PEPPER \
#            OM_THREAD_TOKEN_SECRET OM_HUB_OAUTH_STATE_KEY \
#            MEILISEARCH_MASTER_KEY DOMAIN_CHECK_SECRET DOMAIN_RESOLVE_SECRET; do
#     echo "$v=$(openssl rand -hex 32)"
#   done
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 33 | tr -d '/+=' | head -c 40)"
#   echo "OM_INIT_SUPERADMIN_PASSWORD=$(openssl rand -base64 18)"
#
# Never reuse a secret across two of these variables, and never reuse a value
# from a dev machine. Rotating JWT_SECRET or AUTH_SECRET signs every user out;
# rotating TENANT_DATA_ENCRYPTION_FALLBACK_KEY or LOOKUP_HASH_PEPPER makes
# already-encrypted data unreadable — treat those two as permanent.
# ==============================================================================


# ==============================================================================
# A. REQUIRED — the stack will not start, or is not safe, without these
# ==============================================================================

# --- Identity of this deployment ---------------------------------------------
# The public hostname. Used by deploy.sh for the post-deploy check. The
# certificate and the nginx vhost hardcode it too — if you change it, change
# deploy/nginx/operis.conf.template and reissue the certificate.
APP_DOMAIN=operis.faheemkamel.com

# Public base URL. Used for password-reset links, invitation emails, OAuth
# redirects and host validation. Wrong value = emails that link nowhere.
APP_URL=https://operis.faheemkamel.com

# --- Container image ---------------------------------------------------------
# OPTIONAL, and normally leave it alone. CI derives the image from the GitHub
# repository and passes both it and the tag to deploy.sh (--image / --digest),
# so the pipeline is the source of truth and a repository rename or org transfer
# is picked up automatically.
#
# This value is only a fallback for running deploy.sh by hand on the server. If
# it disagrees with what CI passes, CI wins and the deploy log says so.
# Previously this was authoritative, and a stale owner here failed the pull with
# an error that read like a registry login problem.
APP_IMAGE=ghcr.io/pca-sds/operis

# --- Gateway network ----------------------------------------------------------
# Operis has no reverse proxy of its own: pca-erp-nginx owns :80/:443 on this
# host and proxies operis.faheemkamel.com to the app container. The app joins
# that stack's docker network so nginx can resolve `operis-app` by DNS.
# Only change this if the pca-erp stack is renamed. `docker network ls` lists it.
EDGE_NETWORK=pca-erp-network

# --- Database ----------------------------------------------------------------
# DATABASE_URL is NOT set here — docker-compose builds it from these three so
# the app and Postgres can never disagree about the credentials.
POSTGRES_USER=operis
POSTGRES_PASSWORD=            # openssl rand -base64 33 | tr -d '/+=' | head -c 40
POSTGRES_DB=operis

# --- Signing and encryption secrets (32-byte hex each) -----------------------
# Auth token signing. In production the app REFUSES TO START if this is missing,
# shorter than 32 characters, or a known placeholder.
JWT_SECRET=
# Session/cookie signing. Preferred over JWT_SECRET by the auth flows.
AUTH_SECRET=
# Only needed if you enable an Auth.js/NextAuth provider; harmless to set.
NEXTAUTH_SECRET=
# Signs cookie-consent records so they cannot be forged.
CONSENT_INTEGRITY_SECRET=

# Tenant data encryption. Operis encrypts PII at rest; this key decrypts it.
# LOSING THIS KEY MEANS LOSING THE DATA. Back it up somewhere other than this
# server (password manager / Vault) the moment you set it.
TENANT_DATA_ENCRYPTION=true
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=
TENANT_DATA_ENCRYPTION_DEBUG=false

# Pepper for lookup hashes (email_hash and friends) so they cannot be attacked
# with rainbow tables or correlated between installations. Also permanent:
# changing it orphans every existing hashed lookup.
LOOKUP_HASH_PEPPER=

# --- Search backend ----------------------------------------------------------
# Meilisearch runs with MEILI_ENV=production, which requires a master key of at
# least 16 bytes. Same value is handed to the app as MEILISEARCH_API_KEY.
MEILISEARCH_MASTER_KEY=

# --- First-boot superadmin ---------------------------------------------------
# Used ONCE, by `mercato init` on the very first container start, to create the
# initial superadmin. Change the password in the UI afterwards; the value stays
# here only so a rebuilt server can re-initialise identically.
OM_INIT_SUPERADMIN_EMAIL=admin@your-domain.com
OM_INIT_SUPERADMIN_PASSWORD=
# Recipient for onboarding notifications and the last-resort email sender.
ADMIN_EMAIL=ops@your-domain.com


# ==============================================================================
# B. PRODUCTION POSTURE — safe defaults; change only with a reason
# ==============================================================================

NODE_ENV=production
# V8 heap ceiling for the app container. Rule of thumb: ~50% of server RAM,
# leaving room for Postgres, Redis and Meilisearch.
#   4 GB VPS -> 1536   8 GB VPS -> 3072   16 GB VPS -> 6144
NODE_OPTIONS=--max-old-space-size=3072

# Marks the instance as a throwaway public demo (banner + locked settings).
# Upstream ships this ON. A real deployment is not a demo.
DEMO_MODE=false

# Allow strangers to self-register a tenant. Leave false for an internal ERP.
SELF_SERVICE_ONBOARDING_ENABLED=false

# Structured logs. Pretty printing is off in production so logs stay parseable
# by `docker logs`, Loki, or whatever you point at them later.
OM_LOG_LEVEL=info
OM_LOG_PRETTY=0

# Background workers and the scheduler run inside the app container. Set both to
# false only once you split them into their own compose services.
AUTO_SPAWN_WORKERS=true
AUTO_SPAWN_SCHEDULER=true

# Optimistic locking for concurrent edits. Default ON; `off` disables it.
# OM_OPTIMISTIC_LOCK=all

# Rate limiting. Strategy, Redis URL and proxy depth are forced by
# docker-compose (redis / redis://redis:6379 / 1) — do not set them here.
RATE_LIMIT_ENABLED=true

# Enterprise modules require a commercial licence for production use.
OM_ENABLE_ENTERPRISE_MODULES=false
OM_ENABLE_ENTERPRISE_MODULES_SSO=false
OM_ENABLE_ENTERPRISE_MODULES_SECURITY=false

# --- Database pool + timeouts ------------------------------------------------
# Keep web_pool_max + worker budget + overhead below PG_MAX_CONNECTIONS (120).
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=10000
# Server-side ceilings so one runaway query cannot exhaust the pool.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000
OM_WORKERS_DB_CONNECTION_BUDGET=20

# --- Postgres server tuning (read by docker-compose, not by the app) ---------
# The host has 22 GB but SHARES it with four other stacks (pca-erp,
# pca_accounting, pca-client-profile, prive-booking) which together already run
# five Postgres instances. These values budget roughly 4 GB for Operis rather
# than sizing as if the box were ours alone.
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_LOG_MIN_DURATION_MS=2000

# --- Redis -------------------------------------------------------------------
# Holds cache + BullMQ queues + rate-limit counters. noeviction is enforced in
# redis.conf, so raise this if you see write errors rather than losing jobs.
REDIS_MAXMEMORY=768mb

# --- Caching -----------------------------------------------------------------
# Strategy and URL are forced by docker-compose (redis). Only TTL is tunable.
CACHE_TTL=300000
ENABLE_CRUD_API_CACHE=true

# --- Ports (internal only; nothing in this stack publishes a host port) ------
CONTAINER_PORT=3000

# --- Attachments -------------------------------------------------------------
# Keep at or below client_max_body_size (32m) in deploy/nginx/operis.conf.template.
OM_ATTACHMENT_MAX_UPLOAD_MB=25
OM_ATTACHMENT_TENANT_QUOTA_MB=512

# --- Extra trusted origins ---------------------------------------------------
# Only if the app is reached on more hostnames than APP_URL.
# APP_ALLOWED_ORIGINS=https://admin.your-domain.com


# ==============================================================================
# C. EMAIL — required for password resets, invitations and notifications
# ==============================================================================
# Without a provider key the app starts fine but silently cannot mail anyone,
# which means nobody can recover an account. Configure this before go-live.
#
# Resend is the built-in provider: https://resend.com — create an API key and
# verify your sending domain (SPF + DKIM) or delivery will land in spam.
RESEND_API_KEY=
# Must be on a domain you verified with the provider.
EMAIL_FROM=no-reply@your-domain.com
# Sender priority: NOTIFICATIONS_EMAIL_FROM > EMAIL_FROM > ADMIN_EMAIL
NOTIFICATIONS_EMAIL_FROM=
# Base URL for customer-portal links in outbound email. REQUIRED in production
# if you use the customer portal — without it, portal emails fail rather than
# mailing a localhost link to a customer.
PLATFORM_PORTAL_BASE_URL=https://app.your-domain.com


# ==============================================================================
# D. AI ASSISTANT — optional, off unless you set a key
# ==============================================================================
# Leave OPENAI_API_KEY empty and the AI Assistant simply stays disabled. It is
# billed per token by the provider, so this is an explicit opt-in.
OM_AI_PROVIDER=openai
OM_AI_MODEL=gpt-5-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=

# Hard ceiling on what providers/models the runtime will accept, whatever a
# tenant sets in the UI. Recommended when a key is live, to cap spend.
# OM_AI_AVAILABLE_PROVIDERS=openai
# OM_AI_AVAILABLE_MODELS_OPENAI=gpt-5-mini

# OCR for uploaded images/PDFs — needs OPENAI_API_KEY.
# OCR_MODEL=gpt-4o
# OM_DEFAULT_ATTACHMENT_OCR_ENABLED=false

# Vector search auto-indexing. Costs an embedding call per indexed record.
OM_DISABLE_VECTOR_SEARCH_AUTOINDEXING=true


# ==============================================================================
# E. SEARCH TUNING — defaults are sane; listed so you know the levers exist
# ==============================================================================
# MEILISEARCH_HOST / MEILISEARCH_API_KEY are set by docker-compose.
# MEILISEARCH_INDEX_PREFIX=om
# MEILISEARCH_REQUEST_TIMEOUT_MS=30000
OM_SEARCH_ENABLED=true
# OM_SEARCH_MIN_LEN=3
# OM_SEARCH_ENABLE_PARTIAL=true
# Never index these field-name substrings (password/token/secret/hash are always
# blocked regardless).
# OM_SEARCH_FIELD_BLOCKLIST=notes,body


# ==============================================================================
# F. CUSTOMER PORTAL CUSTOM DOMAINS — only if customers bring their own domain
# ==============================================================================
# Ignore this whole block: the nginx vhost serves exactly APP_DOMAIN, and
# per-customer domains would need their own certificates on a gateway that
# belongs to another stack.
#
# PLATFORM_PRIMARY_HOST=app.your-domain.com
# PLATFORM_DOMAINS=app.your-domain.com
# DOMAIN_CHECK_SECRET=
# DOMAIN_RESOLVE_SECRET=          # HIGH VALUE: leaking it enumerates every tenant domain
# CUSTOM_DOMAIN_CNAME_TARGET=app.your-domain.com


# ==============================================================================
# G. OBSERVABILITY — optional, off by default
# ==============================================================================
# Vendor-neutral OTLP export (SigNoz, New Relic, Grafana Cloud, …).
# TELEMETRY_BACKEND=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.eu.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=...
# OTEL_SERVICE_NAME=operis
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# TELEMETRY_SAMPLING_RATIO=0.1

# New Relic agent (separate from OTLP above; pick one, not both).
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=operis-production


# ==============================================================================
# H. EMAIL CHANNELS / INTEGRATIONS — optional
# ==============================================================================
# Per-user Gmail/IMAP mailboxes, inbound reply threading.
# OM_THREAD_TOKEN_SECRET=
# OM_HUB_OAUTH_STATE_KEY=
# Keep both of these false in production — they disable IMAP transport safety.
OM_CHANNEL_IMAP_ALLOW_INSECURE_TRANSPORT=false
OM_CHANNEL_IMAP_ALLOW_INTERNAL_HOSTS=false

# Stripe payments (or configure per-tenant in the Integrations UI instead).
# OM_INTEGRATION_STRIPE_ENABLED=false
# OM_INTEGRATION_STRIPE_SECRET_KEY=
# OM_INTEGRATION_STRIPE_PUBLISHABLE_KEY=
# OM_INTEGRATION_STRIPE_WEBHOOK_SECRET=

# S3-compatible object storage for attachments (otherwise they live on the
# attachments volume on this server, and your only copy is that volume).
# OM_ENABLE_STORAGE_S3=false
# OM_INTEGRATION_STORAGE_S3_BUCKET=
# OM_INTEGRATION_STORAGE_S3_REGION=
# OM_INTEGRATION_STORAGE_S3_ACCESS_KEY_ID=
# OM_INTEGRATION_STORAGE_S3_SECRET_ACCESS_KEY=
# OM_INTEGRATION_STORAGE_S3_ENDPOINT=


# ==============================================================================
# I. BRANDING
# ==============================================================================
# Without these the API docs footer shows upstream Open Mercato's name and
# links to their privacy policy and terms — i.e. another company's legal pages.
OM_BRAND_NAME=Operis
# OM_PRIVACY_URL=https://your-domain.com/privacy
# OM_TERMS_URL=https://your-domain.com/terms
OM_HIDE_BACKEND_FOOTER=true


# ==============================================================================
# J. DO NOT SET THESE IN PRODUCTION
# ==============================================================================
# OM_AUTOLOGIN_EMAIL / OM_AUTOLOGIN_PASSWORD  — signs every visitor in automatically
# FORCE_HOST_SECRET                            — test-only Host header spoofing
# OM_DEV_SEED_PASSWORD                         — dev seed accounts
# DEMO_MODE=true                               — see section B
# NEXT_PUBLIC_UMES_DEVTOOLS=true               — dev tooling in the browser
#
# Note on NEXT_PUBLIC_* generally: Next.js inlines those into the client bundle
# at BUILD time. Setting one here changes nothing in the browser — it would have
# to be a build argument in the CI workflow. The CI image is built without a
# .env file, so all client-side NEXT_PUBLIC_ flags are already at their
# safe/off defaults.


# ==============================================================================
# K. SET BY DOCKER-COMPOSE — adding them here has no effect
# ==============================================================================
# DATABASE_URL, REDIS_URL, CACHE_REDIS_URL, QUEUE_REDIS_URL, EVENTS_REDIS_URL,
# CACHE_STRATEGY, QUEUE_STRATEGY, RATE_LIMIT_STRATEGY,
# RATE_LIMIT_TRUST_PROXY_DEPTH, MEILISEARCH_HOST, MEILISEARCH_API_KEY,
# INTERNAL_APP_ORIGIN, INIT_MARKER_FILE, PORT, HOSTNAME, NODE_ENV
#
# They are pinned in docker-compose.prod.yml because they describe the container
# topology. The `environment:` block wins over this file, so a stale copy here
# is ignored rather than silently breaking the deployment.
