#!/usr/bin/env bash
# ==============================================================================
# `dc` — docker compose wrapper for /opt/operis
# ==============================================================================
# The stack reads two env files: .env (your secrets, hand-written) and
# .image.env (the current image tag, written by deploy.sh). Plain
# `docker compose` only picks up the first, so it would fail substitution on
# ${APP_IMAGE_TAG}. This wrapper supplies both.
#
#   ./dc ps                     what is running
#   ./dc logs -f app            follow application logs
#   ./dc restart app            restart just the app
#
# TLS and routing live in the pca-erp stack, not here:
#   docker logs --tail 100 pca-erp-nginx
#   docker exec pca-erp-certbot certbot certificates
#   ./dc exec app sh            shell inside the app container
#   ./dc exec postgres psql -U operis -d operis
#   ./dc down                   stop everything (volumes and data survive)
#   ./dc stats                  live resource usage
# ==============================================================================

set -Eeuo pipefail

# Defaults to the directory this script LIVES IN, not a hardcoded path.
#
# It used to default to /opt/operis outright. With a second stack on the same host
# that is a loaded gun: `cd /opt/operis-staging && ./dc down -v` would cd straight
# back to /opt/operis and destroy PRODUCTION's volumes, having been typed, read and
# reviewed as a staging command. Resolving from $0 means a script sitting in
# /opt/operis-staging operates on /opt/operis-staging.
#
# Production is unaffected: deploy.sh, backup.sh and dc all live in /opt/operis
# there, so the default still resolves to /opt/operis. CI passes APP_DIR explicitly
# either way.
APP_DIR="${APP_DIR:-$(cd -- "$(dirname -- "$0")" && pwd)}"
cd "$APP_DIR"

[ -f .env ]       || { echo "ERROR: $APP_DIR/.env missing" >&2; exit 1; }
[ -f .image.env ] || printf 'APP_IMAGE_TAG=latest\n' > .image.env

case "${1:-}" in
  stats)
    shift
    exec docker stats --no-stream "$@"
    ;;
  "")
    sed -n '5,20p' "$0"
    exit 0
    ;;
esac

exec docker compose \
  --env-file .env \
  --env-file .image.env \
  -f docker-compose.yml \
  "$@"
